{
  "log": { "level": "debug", "timestamp": true },
  "dns": {
    "servers": [
      { "type": "local", "tag": "dns-local" },
      {
        "type": "https", "tag": "dns-remote",
        "server": "1.1.1.1", "server_port": 443, "path": "/dns-query",
        "detour": "proxy"
      },
      { "type": "fakeip", "tag": "dns-fakeip", "inet4_range": "198.18.0.0/15", "inet6_range": "fc00::/18" }
    ],
    "rules": [
      { "query_type": ["A", "AAAA"], "domain_suffix": ["ifconfig.me"], "action": "route", "server": "dns-fakeip" },
      { "query_type": ["A", "AAAA"], "rule_set": ["geosite-category-games"], "action": "route", "server": "dns-fakeip" }
    ],
    "final": "dns-local",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "tun", "tag": "tun-in",
      "address": ["172.19.0.1/30", "fdfe:dcba:9876::1/126"],
      "mtu": 9000,
      "auto_route": true,
      "strict_route": true,
      "auto_redirect": false
    }
  ],
  "outbounds": [
    {
      "type": "selector", "tag": "proxy",
      "outbounds": ["auto", "mudfish-tw-1", "mudfish-jp-1"],
      "default": "auto",
      "interrupt_exist_connections": false
    },
    {
      "type": "urltest", "tag": "auto",
      "outbounds": ["mudfish-tw-1", "mudfish-jp-1"],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m", "tolerance": 50, "idle_timeout": "30m"
    },
    {
      "type": "socks", "tag": "mudfish-tw-1",
      "server": "35.236.137.214", "server_port": 18081, "version": "5",
      "username": "${MUDFISH_USER}", "password": "${MUDFISH_PASS}"
    },
    {
      "type": "socks", "tag": "mudfish-jp-1",
      "server": "47.74.24.154", "server_port": 18081, "version": "5",
      "username": "${MUDFISH_USER}", "password": "${MUDFISH_PASS}"
    },
    { "type": "direct", "tag": "direct" }
  ],
  "route": {
    "rules": [
      { "action": "sniff", "sniffer": ["http", "tls", "quic", "dns", "stun"], "timeout": "300ms" },
      { "protocol": "dns", "action": "hijack-dns" },
      { "clash_mode": "Direct", "action": "route", "outbound": "direct" },
      { "clash_mode": "Global", "action": "route", "outbound": "proxy" },
      { "ip_is_private": true, "action": "route", "outbound": "direct" },
      {
        "type": "logical", "mode": "and",
        "rules": [ { "network": ["udp"] }, { "process_name": ["stunfallback"] } ],
        "action": "route", "outbound": "direct"
      },
      { "process_name": ["curl", "stunprobe", "stunfallback"], "action": "route", "outbound": "proxy" },
      { "domain_suffix": ["ifconfig.me"], "action": "route", "outbound": "proxy" },
      { "rule_set": ["geosite-category-ads-all"], "action": "reject" },
      { "rule_set": ["geosite-category-games"], "action": "route", "outbound": "proxy" }
    ],
    "rule_set": [
      { "type": "local", "tag": "geosite-category-games", "format": "binary", "path": "/m0/rulesets/geosite/category-games.srs" },
      { "type": "local", "tag": "geosite-category-ads-all", "format": "binary", "path": "/m0/rulesets/geosite/category-ads-all.srs" }
    ],
    "final": "direct",
    "auto_detect_interface": true,
    "default_domain_resolver": "dns-local"
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:19090",
      "secret": "${CLASH_SECRET}",
      "default_mode": "Rule"
    },
    "cache_file": { "enabled": true, "path": "cache.db", "store_fakeip": true }
  }
}
