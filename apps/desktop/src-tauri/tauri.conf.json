{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProxyDesk",
  "version": "0.6.0",
  "identifier": "tw.proxydesk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "ProxyDesk",
    "shortDescription": "Per-app / per-domain routing to Mudfish SOCKS5",
    "copyright": "ProxyDesk contributors. Bundles sing-box (GPL-3.0) as an unmodified separate executable.",
    "externalBin": ["binaries/sing-box"],
    "resources": ["resources/rulesets/**/*", "resources/THIRD_PARTY_NOTICES.txt"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["TradChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
